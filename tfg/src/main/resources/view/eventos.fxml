<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>

<VBox spacing="15"
      style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.onepiececollectr.EventosController">
      

    <!-- 🏷️ Título -->
    <Label text="Eventos"
           style="-fx-font-size: 24; -fx-font-weight: bold;" />
    <!-- 🔍 Buscador -->
           <TextField fx:id="searchField" promptText="🔍 Buscar evento..." />

    <Button text="⭐ Solo favoritos" onAction="#toggleFavorites"/>
    <!-- 📝 Formulario -->
    <TextField fx:id="nameField" promptText="Nombre del evento"/>
    <DatePicker fx:id="datePicker"/>
    <TextField fx:id="locationField" promptText="Ubicación"/>

    <Button text="Guardar evento" onAction="#saveEvent"/>
    

    <!-- 📢 Mensajes -->
    <Label fx:id="selectedEventLabel"
           text=""
           style="-fx-font-size: 14;" />

    <!-- 📦 Contenedor que crece -->
    <VBox VBox.vgrow="ALWAYS">

        <!-- 📜 Scroll dinámico -->
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    VBox.vgrow="ALWAYS">

            <content>
                <VBox fx:id="eventList" spacing="10"/>
            </content>

        </ScrollPane>

    </VBox>

</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="30" alignment="CENTER"
      style="-fx-background-color: #0d1b2a; -fx-padding: 40;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.onepiececollectr.DashboardController">

    <Label text="Home"
           style="-fx-font-size: 34;
                  -fx-font-weight: bold;
                  -fx-text-fill: #e8c96d;" />

    <!-- ── Tarjetas de estadísticas ── -->
    <HBox spacing="30" alignment="CENTER">

        <VBox alignment="CENTER" spacing="10"
              onMouseEntered="#onCardHover" onMouseExited="#onCardExit"
              style="-fx-background-color: #1a2c42;
                     -fx-padding: 24 32;
                     -fx-background-radius: 14;
                     -fx-border-color: #2e4a6b;
                     -fx-border-radius: 14;
                     -fx-border-width: 1;
                     -fx-cursor: hand;">
            <Label text="🃏 Cartas en colección"
                   style="-fx-text-fill: #7fb3d3; -fx-font-size: 13px;"/>
            <Label fx:id="cardsCount" text="0"
                   style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #e8c96d;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="10"
              onMouseEntered="#onCardHover" onMouseExited="#onCardExit"
              style="-fx-background-color: #1a2c42;
                     -fx-padding: 24 32;
                     -fx-background-radius: 14;
                     -fx-border-color: #2e4a6b;
                     -fx-border-radius: 14;
                     -fx-border-width: 1;
                     -fx-cursor: hand;">
            <Label text="📦 Mazos creados"
                   style="-fx-text-fill: #7fb3d3; -fx-font-size: 13px;"/>
            <Label fx:id="decksCount" text="0"
                   style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #e8c96d;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="10"
              onMouseEntered="#onCardHover" onMouseExited="#onCardExit"
              style="-fx-background-color: #1a2c42;
                     -fx-padding: 24 32;
                     -fx-background-radius: 14;
                     -fx-border-color: #2e4a6b;
                     -fx-border-radius: 14;
                     -fx-border-width: 1;
                     -fx-cursor: hand;">
            <Label text="📅 Eventos próximos"
                   style="-fx-text-fill: #7fb3d3; -fx-font-size: 13px;"/>
            <Label fx:id="eventsCount" text="0"
                   style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #e8c96d;"/>
        </VBox>

    </HBox>

    <!-- ── Próximo evento ── -->
    <VBox spacing="8" alignment="CENTER"
          style="-fx-background-color: #1a2c42;
                 -fx-padding: 20 32;
                 -fx-background-radius: 14;
                 -fx-border-color: #2e4a6b;
                 -fx-border-radius: 14;
                 -fx-border-width: 1;">
        <Label text="📅 Próximo evento"
               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #e8c96d;"/>
        <Label fx:id="nextEventLabel" text="Sin eventos"
               style="-fx-font-size: 14; -fx-text-fill: #c8dce8;"/>
    </VBox>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import java.lang.String?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.onepiececollectr.Principal">

    <stylesheets>
        <String fx:value="@sidebar.css"/>
    </stylesheets>

    <left>
        <VBox fx:id="sidebar" spacing="6" prefWidth="190"
              style="-fx-background-color: #6b1111; -fx-padding: 10 8 10 8;">

            <Button fx:id="btnToggle" text="☰"
                    onAction="#toggleSidebar"
                    styleClass="sidebar-toggle"
                    maxWidth="Infinity"/>

            <Separator style="-fx-opacity: 0.35;"/>

            <Button fx:id="btnDashboard" text="🏠  Home"
                    prefWidth="170" onAction="#loadDashboard"
                    styleClass="sidebar-btn"/>

            <Button fx:id="btnColeccion" text="📦  Colección"
                    prefWidth="170" onAction="#loadColeccion"
                    styleClass="sidebar-btn"/>

            <Button fx:id="btnMazos" text="🃏  Mazos"
                    prefWidth="170" onAction="#loadMazos"
                    styleClass="sidebar-btn"/>

            <Button fx:id="btnMercado" text="🏪  Mercado"
                    prefWidth="170" onAction="#loadMercado"
                    styleClass="sidebar-btn"/>

            <Button fx:id="btnEventos" text="📅  Eventos"
                    prefWidth="170" onAction="#loadEventos"
                    styleClass="sidebar-btn"/>

        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea"/>
    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.*?>

<VBox spacing="16"
      alignment="TOP_CENTER"
      style="-fx-background-color: #0d1b2a; -fx-padding: 28;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.onepiececollectr.MazosController">

    <!-- ── TÍTULO ── -->
    <Label text="Mis Mazos"
           style="-fx-font-size: 28;
                  -fx-font-weight: bold;
                  -fx-text-fill: #e8c96d;" />

    <!-- ── FORMULARIO DE CREACIÓN ── -->
    <VBox spacing="12"
          style="-fx-background-color: #1a2c42;
                 -fx-padding: 18;
                 -fx-background-radius: 12;
                 -fx-border-color: #2e4a6b;
                 -fx-border-radius: 12;
                 -fx-border-width: 1;">

        <Label text="Crear nuevo mazo"
               style="-fx-text-fill: #7fb3d3;
                      -fx-font-size: 13px;
                      -fx-font-weight: bold;" />

        <TextField fx:id="deckNameField"
                   promptText="Nombre del mazo"
                   style="-fx-background-color: #0d1b2a;
                          -fx-text-fill: #c8dce8;
                          -fx-prompt-text-fill: #4a6fa5;
                          -fx-border-color: #2e4a6b;
                          -fx-border-radius: 6;
                          -fx-background-radius: 6;
                          -fx-padding: 8 12;" />

        <!-- Selección de colores -->
        <Label text="Color del mazo (máx. 2):"
               style="-fx-text-fill: #7fb3d3; -fx-font-size: 12px;" />

        <HBox spacing="14" alignment="CENTER_LEFT">
            <CheckBox fx:id="redColor"    text="🔴 Rojo"   style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
            <CheckBox fx:id="blueColor"   text="🔵 Azul"   style="-fx-text-fill: #5dade2; -fx-font-weight: bold;"/>
            <CheckBox fx:id="greenColor"  text="🟢 Verde"  style="-fx-text-fill: #2ecc71; -fx-font-weight: bold;"/>
            <CheckBox fx:id="yellowColor" text="🟡 Amarillo" style="-fx-text-fill: #f1c40f; -fx-font-weight: bold;"/>
            <CheckBox fx:id="purpleColor" text="🟣 Morado" style="-fx-text-fill: #9b59b6; -fx-font-weight: bold;"/>
            <CheckBox fx:id="blackColor"  text="⚫ Negro"  style="-fx-text-fill: #95a5a6; -fx-font-weight: bold;"/>
        </HBox>

        <Button text="➕ Crear mazo"
                onAction="#createDeck"
                style="-fx-background-color: #e8c96d;
                       -fx-text-fill: #0d1b2a;
                       -fx-font-weight: bold;
                       -fx-font-size: 13px;
                       -fx-cursor: hand;
                       -fx-background-radius: 7;
                       -fx-padding: 9 20;" />
    </VBox>

    <!-- ── LISTA DE MAZOS ── -->
    <VBox fx:id="deckList" spacing="10" alignment="TOP_CENTER"/>

    <!-- ── EXPORTAR ── -->
    <Button text="📄 Exportar lista"
            onAction="#exportarMazoPDF"
            style="-fx-background-color: #2e4a6b;
                   -fx-text-fill: #c8dce8;
                   -fx-font-size: 12px;
                   -fx-cursor: hand;
                   -fx-background-radius: 7;
                   -fx-padding: 7 16;" />

</VBox>

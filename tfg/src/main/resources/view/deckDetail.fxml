<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ScrollPane?>

<VBox spacing="0"
      alignment="TOP_CENTER"
      style="-fx-background-color: #0d1b2a;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.onepiececollectr.MazosController">

    <!-- ── HEADER ── -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #1a2c42;
                 -fx-padding: 14 20 14 20;
                 -fx-border-color: #2e4a6b;
                 -fx-border-width: 0 0 2 0;">

        <Button text="← Volver"
                onAction="#volver"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #7fb3d3;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;
                       -fx-border-color: #2e4a6b;
                       -fx-border-radius: 6;
                       -fx-background-radius: 6;
                       -fx-padding: 6 14;" />

        <Region HBox.hgrow="ALWAYS" />

        <VBox alignment="CENTER" spacing="2">
            <Label fx:id="lblNombreMazo"
                   text="Mazo"
                   style="-fx-font-size: 17px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #e8c96d;
                          -fx-cursor: hand;"
                   onMouseClicked="#onClickNombre" />
            <Label text="(doble clic para renombrar)"
                   style="-fx-font-size: 9px; -fx-text-fill: #4a6fa5;" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <Button text="🗑 Eliminar mazo"
                onAction="#eliminarMazoActual"
                style="-fx-background-color: #7b2020;
                       -fx-text-fill: white;
                       -fx-font-size: 11px;
                       -fx-cursor: hand;
                       -fx-background-radius: 6;
                       -fx-padding: 7 12;" />

        <Button text="+ Añadir cartas"
                onAction="#irAColeccionParaEditar"
                style="-fx-background-color: #e8c96d;
                       -fx-text-fill: #0d1b2a;
                       -fx-font-weight: bold;
                       -fx-font-size: 12px;
                       -fx-cursor: hand;
                       -fx-background-radius: 6;
                       -fx-padding: 7 16;" />
    </HBox>

    <!-- ── CONTADOR ── -->
    <HBox alignment="CENTER"
          style="-fx-padding: 10 0 4 0;">
        <Label fx:id="deckInfoLabel"
               text="Mazo (0/50)"
               style="-fx-font-size: 13px;
                      -fx-text-fill: #7fb3d3;
                      -fx-font-weight: bold;" />
    </HBox>

    <!-- ── ORDENACIÓN ── -->
    <HBox alignment="CENTER" spacing="18"
          style="-fx-padding: 2 0 8 0;">
        <Label text="Ordenar por:"
               style="-fx-text-fill: #4a6fa5; -fx-font-size: 11px;" />
        <CheckBox fx:id="sortCoste"  text="Coste"  onAction="#renderOrdenado"
                  style="-fx-text-fill: #c8dce8; -fx-font-size: 12px;" />
        <CheckBox fx:id="sortNombre" text="Nombre" onAction="#renderOrdenado"
                  style="-fx-text-fill: #c8dce8; -fx-font-size: 12px;" />
        <CheckBox fx:id="sortColor"  text="Color"  onAction="#renderOrdenado"
                  style="-fx-text-fill: #c8dce8; -fx-font-size: 12px;" />
    </HBox>

    <!-- ── GRID DE CARTAS con scroll ── -->
    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background: #0d1b2a;
                       -fx-background-color: #0d1b2a;
                       -fx-border-color: transparent;">
        <content>
            <GridPane fx:id="deckGrid"
                      hgap="12" vgap="14"
                      alignment="TOP_CENTER"
                      style="-fx-padding: 16 20 24 20;" />
        </content>
    </ScrollPane>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="stackRoot" prefHeight="650.0" prefWidth="950.0" 
           xmlns:fx="http://javafx.com/fxml" 
           fx:controller="com.onepiececollectr.Login">
    
    <!-- Capa 1: Fondo -->
    <ImageView fx:id="imgFondo" pickOnBounds="true" />

    <!-- Capa 2: Filtro oscuro (un poco más denso para que el beige resalte) -->
    <Region style="-fx-background-color: rgba(0,0,0,0.6);" />

    <!-- Capa 3: Formulario -->
    <VBox alignment="CENTER">
        <VBox alignment="CENTER" spacing="25" maxWidth="400" prefWidth="400"
              style="
                -fx-background-color: #f5f5dc; /* Color Beige/Crema */
                -fx-background-radius: 20; 
                -fx-padding: 50; 
                -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 30, 0, 0, 0);
                -fx-border-color: #d4af37; /* Borde color oro viejo */
                -fx-border-width: 2;
                -fx-border-radius: 20;
              ">
            
            <Label text="OnePieceCollectr" 
                   style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #5d4037; -fx-font-family: 'Verdana';" />
            
            <Separator maxWidth="150" style="-fx-opacity: 0.5;" />

            <VBox spacing="15">
                <!-- Inputs con fondo ligeramente más claro que la card para que contrasten -->
                <TextField fx:id="usernameField" promptText="Nombre de usuario" 
                           prefHeight="45" 
                           style="
                            -fx-background-color: #fffaf0; 
                            -fx-background-radius: 10; 
                            -fx-border-color: #bcaaa4; 
                            -fx-border-radius: 10;
                           " />
                
                <PasswordField fx:id="passwordField" promptText="Contraseña"
                               onAction="#IniciarSesion"
                               prefHeight="45"
                               style="
                                -fx-background-color: #fffaf0; 
                                -fx-background-radius: 10; 
                                -fx-border-color: #bcaaa4; 
                                -fx-border-radius: 10;
                               " />
            </VBox>

            <!-- Botón en color marrón cuero o azul oscuro mate (menos agresivo) -->
            <Button text="Iniciar Sesión" onAction="#IniciarSesion" 
                    maxWidth="Infinity" prefHeight="50"
                    style="
                        -fx-background-color: #795548; 
                        -fx-text-fill: white; 
                        -fx-font-weight: bold; 
                        -fx-background-radius: 10; 
                        -fx-cursor: hand; 
                        -fx-font-size: 15;
                    " />
            
            <Button text="Crear Cuenta" onAction="#registrarNuevoUsuario"
                    style="-fx-background-color: transparent; -fx-text-fill: #5d4037; -fx-underline: true; -fx-cursor: hand;" />
        </VBox>
    </VBox>

    <!-- Capa 4: Controles de ventana (encima de todo para recibir clics) -->
    <HBox fx:id="winControls" spacing="2"
          alignment="TOP_RIGHT"
          maxWidth="Infinity"
          pickOnBounds="false"
          style="-fx-padding: 4 6 0 0;">
        <Button fx:id="btnMin" text="−" onAction="#minimizeWindow"/>
        <Button fx:id="btnMax" text="□" onAction="#maximizeWindow"/>
        <Button fx:id="btnCls" text="✕" onAction="#closeWindow"/>
    </HBox>
</StackPane>
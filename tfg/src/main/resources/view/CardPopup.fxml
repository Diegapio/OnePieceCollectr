<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="16"
      style="-fx-padding: 24;
             -fx-background-color: #0d1b2a;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.onepiececollectr.CardDetailController">

    <Label fx:id="nameLabel"
           text="Nombre de la Carta"
           style="-fx-font-size: 17;
                  -fx-font-weight: bold;
                  -fx-text-fill: #e8c96d;" />

    <ImageView fx:id="cardImage"
               fitHeight="250" fitWidth="180"
               pickOnBounds="true" preserveRatio="true" />

    <!-- ── CONTROLES DE CANTIDAD ── -->
    <HBox alignment="CENTER" spacing="10">

        <Button onAction="#handleMenos4" text="x0"
                style="-fx-background-color: #7b2020;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;
                       -fx-background-radius: 6;
                       -fx-padding: 7 14;" />

        <Button fx:id="btnMenos" onAction="#handleMenos" text="−"
                style="-fx-background-color: #2e4a6b;
                       -fx-text-fill: #c8dce8;
                       -fx-font-size: 16;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;
                       -fx-background-radius: 6;
                       -fx-padding: 6 16;" />

        <Label fx:id="lblCantidad" text="x0"
               style="-fx-font-size: 22;
                      -fx-font-weight: bold;
                      -fx-text-fill: #e8c96d;
                      -fx-min-width: 50;
                      -fx-alignment: center;" />

        <Button fx:id="btnMas" onAction="#handleMas" text="+"
                style="-fx-background-color: #2e4a6b;
                       -fx-text-fill: #c8dce8;
                       -fx-font-size: 16;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;
                       -fx-background-radius: 6;
                       -fx-padding: 6 16;" />

        <Button onAction="#handleMas4" text="MAX"
                style="-fx-background-color: #e8c96d;
                       -fx-text-fill: #0d1b2a;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;
                       -fx-background-radius: 6;
                       -fx-padding: 7 14;" />

    </HBox>

    <Button onAction="#handleCerrar" text="Aceptar"
            style="-fx-background-color: #1a2c42;
                   -fx-text-fill: #c8dce8;
                   -fx-font-size: 13px;
                   -fx-cursor: hand;
                   -fx-background-radius: 7;
                   -fx-border-color: #2e4a6b;
                   -fx-border-radius: 7;
                   -fx-padding: 7 28;" />

</VBox>

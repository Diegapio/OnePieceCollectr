<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox spacing="20"
      alignment="TOP_CENTER"
      style="-fx-padding: 20;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.onepiececollectr.MazosController">
     
<Button text="⬅ Volver a mazos"
        onAction="#goBack"/>
    <Label text="Cartas del mazo"
           style="-fx-font-size: 24; -fx-font-weight: bold;" />

       <Button text="Añadir más cartas" 
        onAction="#irAColeccionParaEditar"
        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 5;" />

    <Label fx:id="deckInfoLabel"
           text="Mazo"
           style="-fx-font-size: 16; -fx-font-weight: bold;" />

    <GridPane fx:id="deckGrid" hgap="10" vgap="10"/>

</VBox>
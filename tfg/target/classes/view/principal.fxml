<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.onepiececollectr.Principal">

    <left>
        <VBox spacing="10" prefWidth="200" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            
            <Label text="Menu" style="-fx-text-fill: white; -fx-font-size: 18;" />

           <Button text="Dashboard" prefWidth="160" onAction="#loadDashboard"/>
<Button text="Colección" prefWidth="160" onAction="#loadColeccion"/>
<Button text="Mazos" prefWidth="160" onAction="#loadMazos"/>
<Button text="Mercado" prefWidth="160" onAction="#loadMercado"/>
<Button text="Eventos" prefWidth="160" onAction="#loadEventos"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea">
         
        </StackPane>
    </center>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.onepiececollectr.GeneradorIAController" style="-fx-padding: 30;">
    <Label text="Generador de Mazos con IA" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
    
    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="txtLider" promptText="Ej: Enel Amarillo o Luffy Red/Green" prefWidth="300"/>
        <Button fx:id="btnGenerar" text="Generar Mazo" onAction="#handleGenerarMazo"/>
    </HBox>

    <TextArea fx:id="txtResultado" editable="false" wrapText="true" prefHeight="400" prefWidth="500" promptText="La recomendación de la IA aparecerá aquí..."/>
    
    <ProgressIndicator fx:id="progress" visible="false"/>
</VBox>
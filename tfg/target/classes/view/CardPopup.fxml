<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 20; -fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.onepiececollectr.CardDetailController">
    <children>
        <Label fx:id="nameLabel" style="-fx-font-size: 18; -fx-font-weight: bold;" text="Nombre de la Carta" />
        
        <ImageView fx:id="cardImage" fitHeight="250.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
        
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button onAction="#handleMenos4" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="x0" />
                <Button fx:id="btnMenos" onAction="#handleMenos" text="-" />
                
                <Label fx:id="lblCantidad" style="-fx-font-size: 20; -fx-font-weight: bold;" text="x0" />
                
                <Button fx:id="btnMas" onAction="#handleMas" text="+" />
                <Button onAction="#handleMas4" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="MAX" />
            </children>
        </HBox>
        
        <Button onAction="#handleCerrar" text="Aceptar" style="-fx-padding: 5 20;"/>
    </children>
</VBox>